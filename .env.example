# Copy to `.env` and fill in secrets. Do not commit `.env`.

DATABASE_URL=

SESSION_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console "Authorized redirect URIs" exactly.
GOOGLE_CALLBACK_URL=https://nexmusic.ai/api/auth/callback/google

VITE_SITE_URL=https://nexmusic.ai
NEXT_PUBLIC_SITE_URL=https://nexmusic.ai

# Comma-separated Google OAuth emails with founder admin access
NEX_FOUNDER_ADMIN_EMAIL=

# Optional: comma-separated Google OAuth subject (sub) IDs that are always admin (preferred over email alone)
# NEX_FOUNDER_ADMIN_USER_IDS=

# Transactional email (Resend) — track approved / rejected / liked
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. NEX <notifications@nexmusic.ai> (domain must be verified in Resend)
NEX_EMAIL_FROM=NEX <notifications@nexmusic.ai>

# Optional: extra CORS origins (comma-separated). nexmusic.ai is included in server defaults.
# CORS_ORIGINS=

# B2B export: salt for anonymized listener_id hashing (defaults to SESSION_SECRET)
# DATA_EXPORT_SALT=

# Optional: POST JSON bundle after npm run export:b2b-bundle or admin push-webhook
# B2B_EXPORT_WEBHOOK_URL=https://your-warehouse-or-zapier-endpoint

# Vercel only: proxy /api to your Railway (etc.) URL — set in Vercel env, not on the API box.
# NEX_API_PROXY_ORIGIN=https://your-app.up.railway.app

# Vite + Firebase (if used)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
